# Postgres connection string, e.g. from Render's "External Database URL"
# (for local dev) or "Internal Database URL" (when set as an env var on the
# deployed Render web service itself).
DATABASE_URL="postgresql://user:password@host:5432/database"

# Get this from https://console.anthropic.com/ — never expose it to the client.
ANTHROPIC_API_KEY=""

# Get this from https://console.deepgram.com/ (Audio Coaching module).
# Set the project's data-retention/training setting to zero-retention in
# Deepgram's own dashboard — this app never stores audio, so the STT
# vendor's own retention policy is the only place audio could linger.
DEEPGRAM_API_KEY=""

PORT=3001

# Comma-separated list of allowed frontend origins for CORS + cookies, e.g.
# "http://localhost:5180,https://classcoach-frontend.onrender.com"
FRONTEND_ORIGINS="http://localhost:5180"

# From Google Cloud Console (APIs & Services > Credentials > OAuth client ID,
# type "Web application"). See server/README.md for exact steps.
GOOGLE_CLIENT_ID=""

# Signs the session cookie — any long random string, keep it secret.
JWT_SECRET=""

# Comma-separated emails that get the admin role on sign-in, e.g.
# "you@example.com,other@example.com"
ADMIN_EMAILS=""

# Max Claude-costing actions per user per day (scenario generation, feedback,
# parent messages, Q&A). Optional — defaults to 50.
DAILY_ACTION_LIMIT=50

# Set to "production" when deployed (enables secure/cross-site session cookies).
NODE_ENV=development

# From https://dashboard.stripe.com/apikeys — the secret key (starts "sk_").
STRIPE_SECRET_KEY=""

# The Price ID (starts "price_") for the $9/month Wivoza Plus recurring
# Price, created once in the Stripe dashboard under Products.
STRIPE_PLUS_PRICE_ID=""

# The signing secret (starts "whsec_") for the webhook endpoint registered
# at https://dashboard.stripe.com/webhooks, pointed at
# https://<this-backend>/api/billing/webhook, subscribed to at least:
# checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted, invoice.paid.
STRIPE_WEBHOOK_SECRET=""
