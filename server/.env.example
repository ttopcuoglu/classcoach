DATABASE_URL="file:./dev.db"

# Get this from https://console.anthropic.com/ — never expose it to the client.
ANTHROPIC_API_KEY=""

PORT=3001

# The web app's origin — needed for CORS + cookies to work cross-origin in dev.
FRONTEND_ORIGIN="http://localhost:5180"

# From Google Cloud Console (APIs & Services > Credentials > OAuth client ID,
# type "Web application"). See server/README.md for exact steps.
GOOGLE_CLIENT_ID=""

# Signs the session cookie — any long random string, keep it secret.
JWT_SECRET=""

# Comma-separated emails that get the admin role on sign-in, e.g.
# "you@example.com,other@example.com"
ADMIN_EMAILS=""

# Max Claude-costing actions per user per day (scenario generation, feedback,
# parent messages, Q&A). Optional — defaults to 50.
DAILY_ACTION_LIMIT=50
