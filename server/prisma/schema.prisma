// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// role is "teacher" (default) | "org_admin" (scoped to their own
// organizationId, see Organization below) | "superadmin" (sees the whole
// platform, granted via the ADMIN_EMAILS env var) — auth/authorization only,
// never shown or settable in any UI. Users sign in with Google OAuth and/or
// an email+password: googleId is the Google account's stable "sub" claim
// (null for password-only signups); passwordHash is a bcrypt hash (null
// for Google-only accounts that never set a password).
model User {
  id                    String    @id @default(cuid())
  googleId              String?   @unique
  passwordHash          String?
  email                 String    @unique
  name                  String?
  role                  String    @default("teacher")
  jobTitle              String? // self-described: Teacher, Instructional Coach, Assistant Principal, Principal, District Leader, Other — distinct from `role`
  schoolName            String? // free text, no directory/verification — separate from the real organizationId relation below
  teachingGoal          String? // "I'd like my students to ___", set during onboarding
  gradeLevels           String? // comma-separated, e.g. "7th,8th"
  subjects              String? // comma-separated, e.g. "Math,Science"
  experienceLevel       String? // "first_year" | "early" (2-5 yrs) | "established" (6-15) | "veteran" (15+) — see server/src/lib/experience.ts, null = not answered
  onboardingProgress    String? // comma-separated completed First-30-Days step ids
  onboardingCompletedAt DateTime? // server-set only, when the onboarding wizard finishes or is skipped
  termsAcceptedAt       DateTime?
  ageConfirmedAt        DateTime? // teacher self-attested they're 13+ at signup — no verification, matches termsAcceptedAt's pattern
  suspendedAt           DateTime? // superadmin-set only; blocks future sign-in, doesn't kill an already-active session
  audioRetentionDays    Int? // null = keep audio-coaching transcripts/reports indefinitely
  focusMetric           String? // the teacher's chosen My Growth focus — see FocusMetric in web/src/lib/focusMetrics.ts, null = none set
  talkVoice             String? // Talk It Through's TTS voice — see TALK_VOICES in server/src/lib/talkVoices.ts, null = default (thalia)
  // A running, Coach-maintained free-text profile: recurring strengths and
  // growth areas, plus "open situations" (an ongoing class or student
  // challenge spanning multiple conversations, described by role/period —
  // never a name). Refreshed by Claude itself after each Ask/Talk It
  // Through turn (see server/src/lib/coachMemory.ts); capped at
  // MAX_COACH_MEMORY_CHARS. Null = no memory built yet.
  coachMemory           String?
  // Teacher-controlled opt-out (Profile). When false, memory is neither
  // read nor updated — the prompt reverts to exactly today's behavior.
  coachMemoryEnabled    Boolean   @default(true)
  // The value coachMemory held before the last write that changed it — one
  // step of undo, since a single bad model turn could otherwise destroy weeks
  // of accumulated context. Null until a second write has happened.
  previousCoachMemory   String?
  // Consent for the recording digest — Coach reading what this teacher's own
  // class recordings measured while they are in a different feature (see
  // server/src/lib/coachDigest.ts). Deliberately separate from
  // coachMemoryEnabled, and off until the teacher says otherwise.
  coachDigestEnabled    Boolean   @default(false)
  organizationId        String? // null = independent teacher, not part of any district
  organization          Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  // "free" | "plus" — individual self-serve billing. Independent of
  // Organization.plan below; a teacher can be "free" here while still
  // getting Plus-equivalent access through a district (see hasActivePlan
  // in server/src/lib/billing.ts).
  plan                  String    @default("free")
  planStatus            String? // "active" | "canceled" | "past_due" — null if never subscribed
  planRenewsAt          DateTime? // current Stripe billing-period end
  stripeCustomerId      String?   @unique
  // "Forgot password" — a SHA-256 hash of the emailed token (never the token
  // itself, so a copy of this table can't reset anyone's password), good for
  // one hour and cleared the moment it's used.
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  // Talk It Through over Telegram (see server/src/routes/telegram.ts). The
  // chat id is a Telegram integer stored as text — it can exceed 32 bits.
  telegramChatId             String?   @unique
  telegramLinkedAt           DateTime?
  // One-time code behind the "Connect Telegram" link on Profile; cleared on use.
  telegramLinkToken          String?   @unique
  telegramLinkTokenExpiresAt DateTime?
  // The conversation Telegram messages currently continue, until it goes
  // idle, gets a takeaway, or the teacher sends /new.
  telegramDebriefId          String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  attempts          ScenarioAttempt[]
  debriefs          Debrief[]
  parentMessages    ParentMessage[]
  usageLogs         UsageLog[]
  audioSessions     AudioSession[]
  lessonPlans       LessonPlan[]
  conversationPreps ConversationPrep[]
  conversationPlans ConversationPlan[]
  assignmentCoachSessions AssignmentCoachSession[]
  pdFocusAreas      PdFocusArea[]
  coachFollowUps    CoachFollowUp[]
  lessonTemplates   LessonTemplate[]
  ltiLinks          LtiUserLink[]
  canvasTokens      CanvasToken[]

  @@index([passwordResetTokenHash])
}

// A school/district that's signed an agreement. joinCode is what its
// teachers enter (at onboarding or later from Profile) to land in this org;
// adminEmails is a comma-separated allowlist — whoever signs up (or already
// has an account) with one of these emails becomes this org's org_admin,
// same mechanism as the platform-wide ADMIN_EMAILS env var, just scoped.
model Organization {
  id               String    @id @default(cuid())
  name             String
  joinCode         String    @unique
  adminEmails      String?
  // "free" | "district" — set once a district's invoice is actually paid
  // (see the Stripe webhook's invoice.paid handler).
  plan             String    @default("free")
  // Whole-building free pilot window (uncapped teacher count, by design —
  // maximizes reach more than a small capped subset). The org acts as
  // fully paid while this is in the future, even with plan="free".
  pilotEndsAt      DateTime?
  stripeCustomerId String?   @unique // separate id-space from individual User customers, used for invoicing
  createdAt        DateTime  @default(now())
  users            User[]
  pdFocusAreas     PdFocusArea[]
  lessonTemplates  LessonTemplate[]
  ltiPlatforms     LtiPlatform[]
}

// A coaching-priority theme (see coachingPriority.ts's PRIORITY_LABELS) an
// admin has explicitly chosen to track over time. title/suggestedAction are
// copied from the client's PRIORITY_LABELS/PD_SUGGESTIONS maps at creation
// time, not referenced live, so later wording changes to those maps never
// rewrite an already-created focus area's own history.
model PdFocusArea {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdBy       User         @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  themeKey        String // one of PRIORITY_LABELS — 'talk-balance' | 'questioning' | 'wait-time' | 'cfu' | 'feedback'
  title           String
  suggestedAction String?
  // { count, teachers, confidence, capturedAt } — the theme's tally at the
  // moment this focus area was created, frozen forever. Compared against a
  // live recomputation of the same tally to answer "did this move."
  baselineSnapshot Json
  // Same shape as baselineSnapshot, captured once at archive time — the
  // "final" numbers this focus area ended on, frozen forever (no live
  // recompute happens for an archived row). Null while active.
  finalSnapshot   Json?
  status          String    @default("active") // "active" | "archived"
  createdAt       DateTime  @default(now())
  archivedAt      DateTime?
}

// One row per Claude-costing call, used to enforce a per-user daily limit
// now that a single shared API key funds every teacher's usage.
model UsageLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String // "scenario_generate" | "attempt_feedback" | "debrief_feedback" | "parent_message" | "qa_ask" | "audio_session_notes" | "lesson_plan_feedback" | "lesson_plan_generate" | "conversation_prep_feedback"
  createdAt DateTime @default(now())
}

// Category is one of: defiance, disengagement, peer_conflict, disruption,
// transitions, technology_misuse — which are now Classroom Management's
// sub-categories, one of six focus areas; see server/src/lib/focusAreas.ts for
// the full list. GradeBand is "K-5", "6-8" or "9-12". Difficulty is
// "beginner" | "intermediate" | "advanced". SQLite has no native enum support
// in Prisma, so these are validated at the application layer instead of the
// schema layer. Scenarios are shared content (curated + generated), not
// scoped to a user.
model Scenario {
  id         String   @id @default(cuid())
  text       String
  // One of the six focus areas (see server/src/lib/focusAreas.ts). Null on
  // rows written before the area axis existed; resolved at the application
  // layer from `category`, which identifies its area on its own.
  focusArea  String?
  category   String
  gradeBand  String
  // The room this scenario was written for. subject was passed to generation
  // and thrown away before; kept now so a scenario can be shown and re-run in
  // the room it was built for. course is 9-12 only (Algebra 2, Chemistry);
  // courseLevel is AP | Honors | Regular | Inclusion.
  subject    String?
  course     String?
  // What the teacher was teaching that week. The only room field that changes
  // weekly, and the one that decides what a scenario is actually about.
  topic      String?
  courseLevel String?
  // Who is in the room — "inclusion" | "english_learners". Multi-select, and
  // separate from courseLevel: a section is routinely more than one at once.
  classMakeup String[] @default([])
  difficulty String   @default("intermediate")
  source     String // "generated" | "curated"
  createdAt  DateTime @default(now())

  attempts ScenarioAttempt[]
}

model ScenarioAttempt {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenarioId     String
  scenario       Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  responseText   String
  feedback       String? // Claude's coaching feedback on the teacher's response
  modelResponse  String? // Claude's suggested model response
  rating         Int? // Claude's private 1-5 self-assessment, for growth trends only — never shown to the teacher as a score
  saved          Boolean  @default(false)
  shareToken     String?  @unique
  createdAt      DateTime @default(now())

  // [{ role: 'user' | 'assistant', text, createdAt }], seeded with the
  // original submission + first feedback, grown by follow-up chat turns.
  // Same convention as AudioSession.reflectConversation.
  conversation   Json?

  // Reflection timeline (Practiced -> Tried in class -> Reflected).
  triedAt        DateTime?
  reflectionNote String?
}

// Backs the "Ask" tab — a teacher either reflecting on something that
// already happened, or asking a general question about any of the six focus
// areas, as opposed to ScenarioAttempt's hypothetical practice. focusArea and
// category are inferred by Claude from the free-text input (the same taxonomy
// Scenario uses, or null when nothing fits — e.g. a broad general question);
// the teacher may also pick an area up front, which constrains the inference
// rather than replacing it.
model Debrief {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  incidentText String
  // One of the six focus areas, inferred by Claude from the free text (or
  // taken from the teacher's pick when they made one). Null on rows written
  // before the area axis existed — all of which are classroom management.
  focusArea    String?
  category     String?
  // The room in play for this question, so coaching lands somewhere real.
  // Defaulted from the teacher's profile, overridable per question. course is
  // 9-12 only; courseLevel is AP | Honors | Regular | Inclusion.
  gradeBand    String?
  subject      String?
  course       String?
  topic        String?
  courseLevel  String?
  classMakeup  String[] @default([])
  feedback     String?
  followUp     String? // "next time" guidance — analogous to ScenarioAttempt.modelResponse
  rating       Int? // same private growth-tracking rating as ScenarioAttempt
  // "ask_tab" | "talk_to_me" — which entry point created this conversation.
  // Null on rows created before this field existed; treated as "ask_tab" at
  // the application layer.
  source       String?
  // "telegram" when the conversation happened over the Telegram bot; null =
  // in the app. Independent of source, which stays "talk_to_me" either way.
  channel      String?
  // When Coach offered, on Telegram, to wrap this conversation up after it
  // went quiet. Offered at most once per conversation.
  telegramWrapUpOfferedAt DateTime?
  saved        Boolean  @default(false)
  shareToken   String?  @unique
  createdAt    DateTime @default(now())

  // Same convention as ScenarioAttempt.conversation.
  conversation Json?

  // { explored, tryNext, notice } — Talk It Through only (source ===
  // 'talk_to_me'). Generated once, manually, when the teacher taps
  // "Finish session"; null until then. Ask's rows never use this field.
  talkTakeaway Json?

  // Specific, adaptable language the teacher could try — Ask only.
  wordsToTry String?

  // Reflection timeline (Practiced -> Tried in class -> Reflected).
  triedAt        DateTime?
  reflectionNote String?

  // The check-in scheduled from this conversation's takeaway, if any.
  coachFollowUp CoachFollowUp? @relation("FollowUpSource")
}

// Coach coming back to ask how a planned step went. Created from a Talk It
// Through takeaway's "try next"; shown on Home once dueAt passes, and opens
// Talk It Through with the plan as context. status: "pending" (not yet
// answered) | "talked" (the teacher started a check-in conversation) |
// "dismissed" (by the teacher) | "replaced" (a newer session's check-in took
// its place — only one is ever pending). Snoozing just moves dueAt.
model CoachFollowUp {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceDebriefId    String   @unique
  sourceDebrief      Debrief  @relation("FollowUpSource", fields: [sourceDebriefId], references: [id], onDelete: Cascade)
  plan               String
  checkInQuestion    String
  dueAt              DateTime
  status             String   @default("pending")
  respondedDebriefId String?
  // When this check-in was sent to the teacher on Telegram; null = not sent
  // (or snoozed since, so it goes out again when next due).
  telegramSentAt     DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId, status, dueAt])
}

// Backs "Write a Message". tone is one of: warm, professional, firm, urgent
// (requesting a meeting is a `purpose`, not a tone). startingAction is one
// of: new, respond, improve — determines which of incidentSummary /
// receivedMessage / existingDraft is populated for a given row.
model ParentMessage {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startingAction  String? // "new" | "respond" | "improve" — null on rows created before this field existed, treated as "new"
  incidentSummary String? // "new" mode: what happened / what needs to be said
  receivedMessage String? // "respond" mode: the message being replied to
  existingDraft   String? // "improve" mode: the teacher's own draft to polish
  recipientType   String? // parent_caregiver | student | colleague | administrator
  purpose         String? // see communicationOptions.ts MESSAGE_PURPOSES
  format          String? // email | text | announcement | phone_call_followup
  tone            String
  draftText       String
  title           String? // teacher-set rename; falls back to a derived summary when null
  saved           Boolean  @default(false)
  createdAt       DateTime @default(now())

  // Same convention as ScenarioAttempt.conversation. Each chat turn here
  // also overwrites draftText with the latest revision — unlike the other
  // three models, the chat reply IS the deliverable, not a discussion
  // alongside a fixed result.
  conversation    Json?
}

// Backs "Practice a Conversation" (source: "practice") and "Review My
// Communication" (source: "review", renamed from "real" — see the
// migration that renames existing rows). category holds the practice
// challenge type (see communicationOptions.ts CHALLENGE_TYPES) and is
// unused/null for review rows, which no longer have a category picker.
model ConversationPrep {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       String? // practice challenge type; null for review rows
  personType     String? // practice only: parent_caregiver | student | colleague | administrator
  difficulty     String? // practice only: supportive | concerned | resistant | highly_escalated
  reviewMode     String? // review only: feedback_only | rewrite_only | both
  source         String   @default("review") // "practice" | "review" (was "practice" | "real")
  gradeBand      String? // "K-5" | "6-8" | "9-12", same bands as Scenario
  situationText  String
  responseText   String
  feedback       String?
  modelResponse  String?
  rating         Int? // same private growth-tracking rating as ScenarioAttempt/Debrief
  // Practice's 6-dimension coaching report: { clarity: {rating,feedback}, empathy: {...},
  // evidence: {...}, boundaries: {...}, collaboration: {...}, resolution: {...},
  // didWell, priority, strongerPhrase, nextStep }. Null for review rows and pre-redesign
  // practice rows (which used feedback/modelResponse instead).
  coachingReport Json?
  title          String? // teacher-set rename; falls back to a derived summary when null
  saved          Boolean  @default(false)
  shareToken     String?  @unique
  createdAt      DateTime @default(now())

  // Same convention as ScenarioAttempt.conversation.
  conversation   Json?
}

// Backs "Prepare for a Conversation" — a structured, multi-section plan
// for a real upcoming conversation, distinct from ConversationPrep's
// single feedback+model-response shape. planContent holds the generated
// plan sections as plain text blocks (dash-prefixed lines for list-shaped
// sections, same convention used everywhere else in this app):
// { opening, mainConcern, facts, questions, reactions, recommendedResponses,
//   phrasesToAvoid, boundaries, closing, nextSteps, adminInvolvement }
model ConversationPlan {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientType  String?
  // What kind of meeting this is (parent conference, IEP/504, post-observation,
  // etc.) — a finer-grained categorization than recipientType, which only
  // captures who's in the room, not what kind of meeting it is.
  meetingType    String?
  // Who will be in the meeting, free text (e.g. "Mom, Dad, the school counselor").
  attendees      String?
  situationText  String
  desiredOutcome String?
  concerns       String?
  background     String?
  meetingFormat  String?
  planContent    Json?
  title          String?
  saved          Boolean  @default(false)
  createdAt      DateTime @default(now())

  // Same convention as ScenarioAttempt.conversation — each chat turn here
  // also revises planContent in place, same "chat reply IS the deliverable"
  // behavior as ParentMessage, since a plan is one evolving deliverable.
  conversation   Json?
}

// Unlike ConversationPlan, the deliverable is NOT produced on creation —
// conversation starts with only Coach's opening question, and
// finalMaterials stays null until the teacher explicitly asks to finalize
// (matches AudioSession.reflectConversation's "discuss first, produce
// later" shape, not ConversationPlan's "generate immediately" shape).
model AssignmentCoachSession {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode           String // 'review' | 'redesign_ai' (older rows may carry a retired 'create'/'improve' value — the workspace falls back to Review-style display for anything unrecognized)
  // 'thinking_partner' | 'limited' | 'no_ai' — only set for 'redesign_ai'
  aiUseLevel     String?
  assignmentType String? // 'classwork' | 'homework' | 'project' | 'assessment' | 'group_task' | 'exit_ticket' | 'other'
  typeDetails    Json? // legacy per-type intake answers from the retired type-specific question sets — no longer written to
  estimatedTime  String? // free text, e.g. "20 minutes" or "2 weeks" — shown as a workspace chip
  specificNeeds  String? // optional free text on learning needs
  gradeLevel     String?
  subject        String?
  objective      String? // optional learning objective/standard context
  originalText   String? // the teacher's pasted/uploaded/described existing assignment — always required now that "create from scratch" is retired
  // The single editable source of truth for the assignment shown in the
  // workspace — independent of how it was first produced (pasted,
  // described, or drafted by Coach). Autosaved as the teacher edits it.
  liveAssignmentText String?
  status         String   @default("draft") // 'draft' | 'completed'
  title          String?
  conversation   Json? // ChatMessage[] — seeded with Coach's opening reply only
  // { working, needsAttention, suggestions } — the Review path's
  // structured output, regenerated on demand from liveAssignmentText.
  reviewSummary  Json?
  // { strategies, guidelines, revisedAssignment } — the Redesign path's
  // structured output. revisedAssignment seeds liveAssignmentText
  // immediately on creation; regenerating never auto-overwrites it again
  // without the teacher applying it explicitly.
  aiResistant    Json?
  // { purpose, gradeFit: {rating, explanation}, rigor: {label,
  // explanation}, meaningfulWork: {rating, explanation, suggestion},
  // aiRisk: {rating, explanation, reasons}, workloadSummary,
  // mainOpportunity: {title, description} } — the Review path's richer
  // structured output, replacing reviewSummary for new sessions.
  // reviewSummary is kept, untouched, for pre-existing rows.
  reviewSnapshot Json?
  // { question, options } — set when the initial analysis (or a
  // /:id/refine call) found one genuinely uncertain, material detail.
  // Cleared once answered. Never gates reviewSnapshot/aiResistant, which
  // are always generated regardless of whether this is set.
  clarifyingQuestion Json?
  // { assignment?, rubric?, scaffolds?, aiUseStatement? } — superseded by
  // liveAssignmentText/reviewSummary/future tool-specific fields; kept for
  // pre-redesign rows.
  finalMaterials Json?
  saved          Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// mode is "feedback" (teacher submits their own plan in planText, gets
// coaching + a private rating) or "generated" (teacher gives only an
// objective + context, Claude drafts a sample single-day plan into the
// doNow/agenda/closure/hots/homework fields — for ideas, not a mandate).
// Structure modeled on a standard gradual-release lesson plan template:
// Standard -> Objective (SWBAT) -> Do Now -> Agenda (I Do/We Do/You Do)
// -> Closure -> HOTS -> Homework.
model LessonPlan {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode              String

  // Required for "generated" mode (nothing else to draft from). Optional for
  // "feedback" mode — a submitted plan usually states its own objective, so
  // the teacher isn't forced to retype it; Claude is told to note when one
  // isn't clearly stated instead.
  objective         String?
  unitName          String?
  essentialQuestion String?
  standard          String?
  subject           String?
  gradeLevel        String?

  // "feedback" mode: the teacher's own submitted plan. "presentation" mode:
  // the extracted, slide-numbered text of an uploaded presentation.
  planText          String?
  feedback          String?
  rating            Int? // same private growth-tracking rating as ScenarioAttempt/Debrief

  // "generated" mode only — Claude's sample plan, one field per template section
  doNow             String?
  agenda            String?
  closure           String?
  hots              String?
  homework          String?

  saved             Boolean  @default(false)
  shareToken        String?  @unique
  createdAt         DateTime @default(now())

  // Same convention as ScenarioAttempt.conversation — "feedback" and
  // "presentation" modes only.
  conversation      Json?

  // The coach's latest proposed rewrite of planText, offered during the
  // follow-up chat — "feedback" and "presentation" modes only. Shown
  // separately, never auto-applied; null until the teacher accepts it
  // (which copies this into planText and clears it) or a newer suggestion
  // replaces it.
  suggestedRevision String?

  // "presentation" mode only — the uploaded file's original name and its
  // slide/page count, both purely for display (e.g. "my-slides.pptx · 12
  // slides"), never used in the review itself beyond the count.
  fileName          String?
  slideCount        Int?

  // "presentation" mode only — { gradeLevelFit, visuals, ideas, length,
  // implementation }, Claude's review of an already-built presentation.
  // Regenerating overwrites this field.
  presentationReview Json?

  // { openingHook, pacing, engagementCheckpoints, explainingTheHardPart,
  // closing } — a structured presentation/delivery coaching pass, generated
  // from the plan's own content (planText for feedback-mode, the assembled
  // doNow/agenda/closure/hots/homework for generated-mode). Regenerating
  // overwrites this field. Never auto-applied to planText/agenda/etc. —
  // delivery advice, not a content edit.
  deliveryCoaching Json?

  // Planning Coach, "generated" mode — which of the two outputs Build a
  // Lesson was asked for: "full" (a complete lesson draft, the default) or
  // "ideas" (3-5 teaching ideas). Null on every plan generated before this
  // choice existed; those are the gradual-release samples still living in
  // doNow/agenda/closure/hots/homework above, and they still render.
  planKind          String?
  durationMinutes   Int? // the class period the lesson was built to fit
  additionalContext String? // student needs, available resources, anything else
  // The text of a file the teacher started from — slides, a reading, a
  // worksheet, an activity. The lesson is built around it rather than from
  // scratch, and it's what the topic/subject suggestions were inferred from.
  sourceMaterial    String?

  // planKind "full". The structure Claude chose for this lesson — direct
  // instruction and guided practice, discussion, inquiry, a lab, or
  // collaborative learning. A label on what it built, not a template it was
  // handed: the sequence fits the learning goal, the grade and the time,
  // rather than every lesson being forced through one shape.
  approach          String?
  successCriteria   String? // what a student who got there can show
  materials         String?
  sequence          Json? // [{ minutes, title, teacher, students }], in teaching order
  checks            Json? // [{ when, check, lookFor }]
  // [{ belief, surface, response }] — misconceptions that are LIKELY for this
  // content, never claims about this teacher's actual students.
  misconceptions    Json?
  exitTicket        Json? // { task, expected, signals, nextStep }
  quickIdeas        Json? // planKind "ideas" — [{ title, how }], 3-5 of them

  // An adaptation (Simplify / Add Challenge / Increase Participation / Adjust
  // Time) Claude has drafted and the teacher has not applied yet:
  // { action, label, summary, minutes, sections } where sections mirrors the
  // lesson fields above, or { planText } for a lesson the teacher brought
  // themselves. Shown for review, never applied on its own.
  pendingAdaptation Json?
  // Every version an applied adaptation replaced, oldest first — so index 0
  // is always the original and no adaptation can lose it.
  versionHistory    Json?

  // Which lesson plan format the teacher picked for this lesson: null = their
  // default (their own default template, else their school's), "wivoza" =
  // Wivoza's own layout, otherwise a LessonTemplate id. Plain text, not a
  // relation, so deleting a template never touches a plan laid out with it.
  templateChoice    String?
  // The lesson laid out in a template: { templateId, templateName, sourceKey,
  // sections: [{ id, title, kind, text }] }. It carries its own copy of the
  // section titles and kinds, so a later edit to the template never rewrites
  // a plan already laid out. sourceKey fingerprints the lesson and template it
  // was made from; when either changes the layout is redone on the next view
  // (see server/src/lib/lessonTemplateModel.ts). Derived, never edited.
  templateContent   Json?

  // planKind "week" (Plan a Week, lessonWeekModel.ts): { days: [{ label,
  // minutes, note, objective, lessonPlanId? }], content } — the daily
  // objectives the teacher checked, then the week filled in. Weeks are left
  // out of the list the iPhone app reads, which has no view for them.
  week              Json?
  // On a full lesson opened from a day of a week: that week's plan id, so the
  // lesson can link back to it. Plain text, like templateChoice.
  weekPlanId        String?
}

// A school's (organizationId) or a teacher's own (userId) lesson plan
// format — exactly one of the two is set. Planning Coach lays a built
// lesson out in it so it can be posted or handed in without retyping.
// sections is [{ id, title, kind, prompt }] in the form's own order; kind
// says what Wivoza writes there (see SECTION_KINDS in lessonTemplateModel.ts)
// and "teacher_fills" means it is left blank on purpose.
model LessonTemplate {
  id              String        @id @default(cuid())
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdByUserId String
  name            String
  cadence         String        @default("daily") // "daily" | "weekly" — weekly layouts are not built yet
  sections        Json
  sourceFileName  String?
  // The one an owner's lessons use unless the teacher picks another. At most
  // one per owner, kept that way by the routes rather than a constraint.
  isDefault       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  archivedAt      DateTime?

  @@index([organizationId])
  @@index([userId])
}

// A recorded class period, transcribed once (never stored as audio) and
// analyzed for a self-coaching report. No sharing, no admin visibility —
// this is strictly the owning teacher's own data, unlike Scenario/Debrief.
// status is one of: setup, recording, paused, transcribing, tagging,
// analyzed, locked — validated at the application layer, same convention
// as Scenario.difficulty / ParentMessage.tone above.
model AudioSession {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  teacherName      String?
  classSubject     String?
  period           String?
  gradeLevel       String?
  sessionDate      DateTime  @default(now())

  consentConfirmed Boolean   @default(false)
  status           String    @default("setup")
  durationSec      Int?

  // Transcription runs server-side and outlives the request that started it,
  // so the teacher can lock their phone the moment they press Stop. These two
  // are what a "Processing 41%" row is drawn from on any device, and what the
  // startup sweep uses to find jobs a restart killed mid-flight.
  transcribeStartedAt DateTime?
  failureReason       String?

  // Trended across sessions, kept as real columns for cheap history queries
  teacherTalkPct   Float?
  studentTalkPct   Float?
  questionCount    Int?
  higherOrderPct   Float?
  avgWaitTimeSec   Float?
  cfuCount         Int?

  // The long tail of metrics, plus coach-editable highlights/phases. One-off
  // use of Json in this schema — the alternative (dozens of scalar columns
  // for a shape that will keep evolving) is worse.
  metricsDetail    Json?
  highlights       Json? // [{ label, timestampSec, excerpt }]
  phases           Json? // [{ label, startSec, endSec }], coach-editable
  // [{ timestampSec, type: 'recall'|'higher_order', waitTimeSec, text, followUps: [{ timestampSec, text }] }]
  // null for sessions analyzed before this was tracked.
  questionLog      Json?
  // [{ timestampSec, text, whatItChecked }] — one entry per detected
  // verbal check-for-understanding phrase. null for sessions analyzed
  // before this was tracked.
  cfuLog           Json?
  // [{ timestampSec, kind: 'generic'|'specific', text }] — one entry per
  // teacher turn counted toward genericFeedbackCount/specificFeedbackCount.
  // null for sessions analyzed before this was tracked.
  feedbackLog      Json?
  // [{ timestampSec, text }] — one entry per detected task-instruction
  // phrase. null for sessions analyzed before this was tracked.
  directiveLog     Json?
  // [{ timestampSec, kind: 'positive'|'corrective', text }] — one entry
  // per teacher turn classified toward positivePhraseCount/
  // correctivePhraseCount. null for sessions analyzed before this was
  // tracked.
  toneLog          Json?
  // [{ timestampSec, text }] — one entry per detected redirection phrase.
  // null for sessions analyzed before this was tracked.
  redirectionLog   Json?

  // Keyword/phrase-matched flags and quotes only — never scored. See
  // audioAnalysis.ts's LessonContentResult for the exact shape.
  lessonContent    Json?

  // { subject, notes: [{ id, label, text, timestampSec, excerpt }] } — null
  // until the teacher explicitly generates it (Lesson Content tab).
  contentNotes     Json?

  // Rubric Lens: the session's evidence organised under a teaching
  // framework's components (see lib/rubricLens.ts's RubricLensResult). Null
  // until the teacher asks for it — never generated automatically.
  rubricLens       Json?

  // The Hard Look: the least generous honest reading of the same evidence
  // (see lib/hardLook.ts's HardLookResult). Null until the teacher asks for
  // it — never generated automatically, and never shown without being asked
  // for, because a teacher who has not chosen this moment should not walk
  // into it.
  hardLook         Json?

  // What the audible student talk was ABOUT — see lib/studentTalkFocus.ts.
  // The only signal in this report that can tell a discussion from a room
  // talking over itself, since both produce the same student talk share.
  // Null when there were too few audible student turns to characterise, which
  // is common and is not zero.
  studentTalkFocus Json?

  // The one moment most worth a second look, chosen by reading the transcript
  // rather than by ranking counts — see lib/momentToRevisit.ts. Null until it
  // has been read; a read that finds nothing is stored as its own status, so
  // "looked and found nothing" never looks like "not looked yet".
  momentToRevisit  Json?

  // What the teacher's own LANGUAGE did, with a verified quote behind every
  // entry — see lib/teachingMoves.ts. These are the only measures in the
  // report that appraise rather than count, and that is defensible for one
  // reason: they are all about the teacher, whose voice the microphone
  // actually has. The same judgments about students were dropped because it
  // does not.
  teachingMoves    Json?
  // The v3 Insights coach notes (lib/insightsNotes.ts): per section a lead,
  // Read more, Keep and Try with a rewrite, written from the page's findings
  // and checked before storing. Keyed by a hash of those findings, so they
  // are rewritten only when what they are about changes.
  insightsNotes    Json?
  // The focus loop (lib/lessonFocus.ts): `next` is the one thing picked on
  // this lesson's report for the teacher's next lesson; `checkIn` is what this
  // lesson's report found for the focus picked on the previous lesson with the
  // same teacher name.
  lessonFocus      Json?

  // A loudness envelope for the recording — one RMS sample per second,
  // measured on the device while recording. NOT audio: speech cannot be
  // reconstructed from a 1Hz amplitude curve, which is what lets this exist
  // alongside the promise that audio is never saved. Feeds lib/settleTime.ts,
  // the only thing that can tell a bubbly room that settles when asked from
  // one where directions compete with chatter — the transcript cannot, since
  // diarization resolves crosstalk away before anything is stored.
  levelTrace       Json?

  // Whether an attention bid HELD — see lib/escalation.ts. Not a count of
  // redirections: a count tells you which group a teacher has, and this tells
  // you whether asking worked, by reading runs of asks in close succession
  // and whether they climbed toward a consequence. Null until read. A read
  // that finds nothing carries its own state, because on a recording the mic
  // largely lost, "no escalation" would be a lie and "not measurable" is the
  // truth.
  escalation       Json?

  // Claude-generated summary of what the class covered + a genuine
  // strength, auto-generated once on the teacher's first Summary view and
  // cached forever after. Null = not yet attempted, or the one retryable
  // failure mode (a Claude/API error) — see the /:id/class-summary route.
  classSummary     String?
  // A short narrative for the Checks & Feedback section. Written in the same
  // model call as classSummary, so it costs nothing extra, and kept separate
  // because it is about the pattern of checks rather than the lesson content.
  checksNarrative  String?
  climateNarrative String?
  // contentNarrative is no longer written: the teacher preferred the existing
  // Content Specialist Notes to a rewrite of them. Kept rather than dropped,
  // since dropping a column is destructive and the three rows that have one
  // cost nothing.
  contentNarrative String?
  talkNarrative    String?
  questionsNarrative String?
  // { talk?, questions?, climate? } — one concrete thing to do next lesson per
  // Insights section, written alongside the narratives above so each follows
  // from the paragraph the teacher reads. A section with nothing worth
  // suggesting is simply absent. Null on reports summarized before this.
  nextSteps        Json?

  strengths        String?
  growthAreas      String?
  nextStep         String?
  followUpDate     DateTime?

  // [{ role: 'user' | 'assistant', text, createdAt }], the Reflect tab's
  // multi-turn coaching chat. Always read/written as one ordered array —
  // same convention as highlights/phases, not a child table.
  reflectConversation Json?

  deleteAfter      DateTime? // computed from User.audioRetentionDays at creation

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  segments         TranscriptSegment[]
  quoteFlags       QuoteFlag[]
}

model TranscriptSegment {
  id            String       @id @default(cuid())
  sessionId     String
  session       AudioSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  speakerLabel  String // "Speaker N" pre-tagging, then "Teacher" | "Student"
  rawSpeakerTag String // original diarized label, kept so re-tagging stays possible
  startSec      Float
  endSec        Float
  text          String
  /// Deepgram's confidence that each word is this speaker's, as
  /// [words, confidence] runs (lib/deepgram.ts). Null on lines transcribed
  /// before it was kept. Recorded to find lines where diarization folded a
  /// student into the teacher; nothing reads it yet.
  speakerConfidence Json?
  createdAt     DateTime     @default(now())
}

// A teacher saying a quote in their report is wrong ("Not right?" in Insights).
//
// Recorded, never acted on: the quote stays on the page. Flags are the eval
// set for the reads that pick quotes, so each one keeps the line it was about
// and the words as they were shown, even if the report is later re-read and
// the quote changes. One flag per teacher per finding per line — pressing it
// twice is still one.
model QuoteFlag {
  id           String       @id @default(cuid())
  sessionId    String
  session      AudioSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId       String
  // Which finding the quote stood for, e.g. "higher_order_questions".
  findingKey   String
  // The transcript line the quote starts in, and the words as shown.
  segmentId    String
  quote        String
  timestampSec Float
  reason       String?
  createdAt    DateTime     @default(now())

  @@unique([sessionId, userId, findingKey, segmentId])
  @@index([sessionId])
}

// A school or district asking about Wivoza from the public /for-schools
// page. Unauthenticated, so everything here is whatever the visitor typed —
// shown only to superadmins, never used to create an account or org.
model SchoolInquiry {
  id               String    @id @default(cuid())
  name             String
  email            String
  role             String
  organizationName String
  // "school" | "district" | "network" | "other"
  organizationType String
  // No longer asked on the form; kept so the column matches the database.
  state            String?
  // A range chosen from a fixed list ("1-25", "26-100", ...), not a count.
  teacherCount     String?
  // No longer asked on the form; kept so the column matches the database.
  interests        String?
  message          String?
  // "new" | "contacted" | "closed"
  status           String    @default("new")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([createdAt])
}

// A school's Canvas, connected to Wivoza over LTI 1.3 (see routes/lti.ts).
// A Canvas admin creates a developer key from Wivoza's config URL; the
// school's Wivoza admin then enters that key's client id here. One row per
// (issuer, clientId): the issuer names the Canvas environment, the client id
// the key, and together they identify whose launches these are.
model LtiPlatform {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  environment     String // "production" | "beta" | "test" — Instructure-hosted Canvas only
  issuer          String
  clientId        String
  authUrl         String
  jwksUrl         String
  createdByUserId String
  createdAt       DateTime     @default(now())
  archivedAt      DateTime?
  links           LtiUserLink[]
  pending         LtiPendingLink[]

  // Send to Canvas (routes/canvas.ts) uses Canvas's REST API, which needs a
  // separate API developer key: the school's Canvas address, that key's
  // client id, and its secret, encrypted (lib/secretBox.ts). All three unset
  // means the school has Wivoza in Canvas but not sending to it.
  canvasUrl          String?
  apiClientId        String?
  apiClientSecretEnc String?
  canvasTokens       CanvasToken[]

  @@unique([issuer, clientId])
}

// A teacher's permission for Wivoza to add pages to their Canvas courses,
// given once in Canvas's own consent screen. Both tokens encrypted; the
// access token lasts an hour and is refreshed with the other.
model CanvasToken {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformId      String
  platform        LtiPlatform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  canvasUserId    String?
  accessTokenEnc  String
  refreshTokenEnc String?
  expiresAt       DateTime
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([userId, platformId])
}

// A Canvas user (the token's `sub`) connected to a Wivoza account. Made only
// when the teacher, signed in to Wivoza, confirms it once — never from the
// email Canvas sends, which a Canvas admin controls.
model LtiUserLink {
  id           String      @id @default(cuid())
  platformId   String
  platform     LtiPlatform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  sub          String
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  lastLaunchAt DateTime?

  @@unique([platformId, sub])
  @@index([userId])
}

// A launch from a Canvas user who is not connected yet, waiting for them to
// confirm which Wivoza account it is. Only a hash of the one-time token is
// kept; it lives for 30 minutes.
model LtiPendingLink {
  tokenHash  String      @id
  platformId String
  platform   LtiPlatform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  sub        String
  name       String?
  expiresAt  DateTime
  createdAt  DateTime    @default(now())
}
