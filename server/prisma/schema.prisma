// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// role is "teacher" (default) | "admin". Signed in via Google — googleId is
// the Google account's stable "sub" claim. No passwords are stored anywhere.
model User {
  id                 String   @id @default(cuid())
  googleId           String   @unique
  email              String   @unique
  name               String?
  role               String   @default("teacher")
  gradeLevels        String? // comma-separated, e.g. "7th,8th"
  subjects           String? // comma-separated, e.g. "Math,Science"
  onboardingProgress String? // comma-separated completed First-30-Days step ids
  audioRetentionDays Int? // null = keep audio-coaching transcripts/reports indefinitely
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  attempts       ScenarioAttempt[]
  debriefs       Debrief[]
  parentMessages ParentMessage[]
  qaExchanges    QAExchange[]
  usageLogs      UsageLog[]
  audioSessions  AudioSession[]
  lessonPlans    LessonPlan[]
}

// One row per Claude-costing call, used to enforce a per-user daily limit
// now that a single shared API key funds every teacher's usage.
model UsageLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String // "scenario_generate" | "attempt_feedback" | "debrief_feedback" | "parent_message" | "qa_ask" | "audio_session_notes" | "lesson_plan_feedback" | "lesson_plan_generate"
  createdAt DateTime @default(now())
}

// Category is one of: defiance, disengagement, peer_conflict, disruption,
// transitions, technology_misuse. GradeBand is "6-8" or "9-12". Difficulty is
// "beginner" | "intermediate" | "advanced". SQLite has no native enum support
// in Prisma, so these are validated at the application layer instead of the
// schema layer. Scenarios are shared content (curated + generated), not
// scoped to a user.
model Scenario {
  id         String   @id @default(cuid())
  text       String
  category   String
  gradeBand  String
  difficulty String   @default("intermediate")
  source     String // "generated" | "curated"
  createdAt  DateTime @default(now())

  attempts ScenarioAttempt[]
}

model ScenarioAttempt {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenarioId     String
  scenario       Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  responseText   String
  feedback       String? // Claude's coaching feedback on the teacher's response
  modelResponse  String? // Claude's suggested model response
  rating         Int? // Claude's private 1-5 self-assessment, for growth trends only — never shown to the teacher as a score
  saved          Boolean  @default(false)
  shareToken     String?  @unique
  createdAt      DateTime @default(now())
}

model QAExchange {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  starred   Boolean  @default(false)
  createdAt DateTime @default(now())
}

// A teacher reflecting on something that already happened, as opposed to
// ScenarioAttempt's hypothetical practice. category is optional and
// user-picked (not inferred) from the same 6 categories as Scenario.
model Debrief {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  incidentText String
  category     String?
  feedback     String?
  followUp     String? // "next time" guidance — analogous to ScenarioAttempt.modelResponse
  rating       Int? // same private growth-tracking rating as ScenarioAttempt
  saved        Boolean  @default(false)
  shareToken   String?  @unique
  createdAt    DateTime @default(now())
}

// tone is one of: warm, firm, informational, requesting_meeting
model ParentMessage {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  incidentSummary String
  tone            String
  draftText       String
  saved           Boolean  @default(false)
  createdAt       DateTime @default(now())
}

// mode is "feedback" (teacher submits their own plan in planText, gets
// coaching + a private rating) or "generated" (teacher gives only an
// objective + context, Claude drafts a sample single-day plan into the
// doNow/agenda/closure/hots/homework fields — for ideas, not a mandate).
// Structure modeled on a standard gradual-release lesson plan template:
// Standard -> Objective (SWBAT) -> Do Now -> Agenda (I Do/We Do/You Do)
// -> Closure -> HOTS -> Homework.
model LessonPlan {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode              String

  objective         String
  unitName          String?
  essentialQuestion String?
  standard          String?
  subject           String?
  gradeLevel        String?

  // "feedback" mode only — the teacher's own submitted plan
  planText          String?
  feedback          String?
  rating            Int? // same private growth-tracking rating as ScenarioAttempt/Debrief

  // "generated" mode only — Claude's sample plan, one field per template section
  doNow             String?
  agenda            String?
  closure           String?
  hots              String?
  homework          String?

  saved             Boolean  @default(false)
  shareToken        String?  @unique
  createdAt         DateTime @default(now())
}

// A recorded class period, transcribed once (never stored as audio) and
// analyzed for a self-coaching report. No sharing, no admin visibility —
// this is strictly the owning teacher's own data, unlike Scenario/Debrief.
// status is one of: setup, recording, paused, transcribing, tagging,
// analyzed, locked — validated at the application layer, same convention
// as Scenario.difficulty / ParentMessage.tone above.
model AudioSession {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  teacherName      String?
  classSubject     String?
  period           String?
  gradeLevel       String?
  sessionDate      DateTime  @default(now())

  consentConfirmed Boolean   @default(false)
  status           String    @default("setup")
  durationSec      Int?

  // Trended across sessions, kept as real columns for cheap history queries
  teacherTalkPct   Float?
  studentTalkPct   Float?
  questionCount    Int?
  higherOrderPct   Float?
  avgWaitTimeSec   Float?
  cfuCount         Int?

  // The long tail of metrics, plus coach-editable highlights/phases. One-off
  // use of Json in this schema — the alternative (dozens of scalar columns
  // for a shape that will keep evolving) is worse.
  metricsDetail    Json?
  highlights       Json? // [{ label, timestampSec, excerpt }]
  phases           Json? // [{ label, startSec, endSec }], coach-editable

  // Keyword/phrase-matched flags and quotes only — never scored. See
  // audioAnalysis.ts's LessonContentResult for the exact shape.
  lessonContent    Json?

  strengths        String?
  growthAreas      String?
  nextStep         String?
  followUpDate     DateTime?

  deleteAfter      DateTime? // computed from User.audioRetentionDays at creation

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  segments         TranscriptSegment[]
}

model TranscriptSegment {
  id            String       @id @default(cuid())
  sessionId     String
  session       AudioSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  speakerLabel  String // "Speaker N" pre-tagging, then "Teacher" | "Student"
  rawSpeakerTag String // original diarized label, kept so re-tagging stays possible
  startSec      Float
  endSec        Float
  text          String
  createdAt     DateTime     @default(now())
}
